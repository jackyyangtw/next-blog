{
  "name": "jacky-dev-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@jacky-dev/web",
    "dev:mobile": "turbo dev --filter=@jacky-dev/mobile",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format:check": "prettier . --check",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/web/**/*.{js,jsx,ts,tsx,mjs}": [
      "pnpm --filter @jacky-dev/web exec eslint --fix",
      "prettier --write"
    ],
    "apps/mobile/**/*.{js,jsx,ts,tsx,mjs}": "prettier --write",
    "packages/**/*.{js,jsx,ts,tsx,mjs}": "prettier --write",
    "**/*.{json,md,yml,yaml,css}": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2",
    "turbo": "^2.8.0"
  }
}
